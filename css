/* =============================================
   AGRO FORTE - FUTURO SUSTENTAVEL
   Estilos do jogo
   ============================================= */

/* Reset geral */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* Fundo da pagina */
body {
  background: #0a1628;          /* Azul escuro */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  font-family: 'Press Start 2P', monospace; /* Fonte pixel art */
  overflow: hidden;             /* Sem barra de rolagem */
}

/* Titulo acima do jogo */
#titulo {
  color: #f9a825;               /* Dourado */
  font-size: 10px;
  margin-bottom: 8px;
  letter-spacing: 1px;
  text-align: center;
}

/* Borda ao redor do canvas */
#canvas-wrapper {
  border: 4px solid #f9a825;
  box-shadow: 0 0 32px rgba(249, 168, 37, 0.4); /* Brilho dourado */
  position: relative;
}

/* O canvas do jogo */
canvas {
  display: block;
  max-width: 100%;
  image-rendering: pixelated;   /* Pixel art nitido, sem blur */
}

/* Botoes de controle (mobile) */
#controles {
  display: flex;
  gap: 12px;
  margin-top: 12px;
}

.btn {
  background: rgba(249, 168, 37, 0.2); /* Dourado transparente */
  color: #f9a825;
  border: 2px solid #f9a825;
  border-radius: 4px;
  padding: 10px 18px;
  font-family: 'Press Start 2P', monospace;
  font-size: 10px;
  cursor: pointer;
  user-select: none;
}

/* Botao pressionado */
.btn:active,
.btn.ativo {
  background: #f9a825;          /* Fica todo dourado */
  color: #000;
}

/* Botao ENTER (verde) */
#btn-enter {
  background: rgba(76, 175, 80, 0.2);
  color: #4caf50;
  border-color: #4caf50;
  font-size: 9px;
}

/* Legenda embaixo */
#legenda {
  display: flex;
  gap: 20px;
  margin-top: 8px;
  font-size: 8px;
  color: #bdbdbd;
  flex-wrap: wrap;
  justify-content: center;
}

#legenda span {
  white-space: nowrap;
}
